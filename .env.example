# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every variable below is read once by euroleague_ai.core.config.Settings.
# ---------------------------------------------------------------------------

# Application
APP_NAME="EuroLeague AI"
ENVIRONMENT=development          # development | test | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console | json  (use json in production)

# Database.  Must use the postgresql+asyncpg:// driver.
# Host is "postgres" inside Docker Compose, "localhost" from your machine.
DATABASE_URL=postgresql+asyncpg://euroleague:euroleague@postgres:5432/euroleague
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Separate database used by the integration test suite.
# Leave unset to skip database-backed tests instead of failing them.
TEST_DATABASE_URL=postgresql+asyncpg://euroleague:euroleague@postgres:5432/euroleague_test

# Redis (caching now, task broker later)
REDIS_URL=redis://redis:6379/0
PROVIDER_CACHE_TTL_SECONDS=900

# EuroLeague data provider
EUROLEAGUE_API_BASE_URL=https://api-live.euroleague.net/v2
EUROLEAGUE_COMPETITION_CODE=E
EUROLEAGUE_DEFAULT_SEASON=E2026
EUROLEAGUE_REQUEST_TIMEOUT_SECONDS=20
EUROLEAGUE_MAX_CONCURRENCY=2
# Conservative: higher values trip the upstream rate limiter during a season
# backfill. The client throttles itself further whenever it sees a 429.
EUROLEAGUE_REQUEST_RATE_PER_SECOND=2
EUROLEAGUE_MAX_RETRIES=5
# Longest rate-limit cooldown to wait through before stopping. Ingestion
# resumes where it left off, so stopping is cheap; use `ingest stats --wait`
# for unattended backfills that should sit through long cooldowns.
EUROLEAGUE_MAX_RETRY_WAIT_SECONDS=60
# Identify yourself politely to the upstream API.
EUROLEAGUE_USER_AGENT="euroleague-ai/0.1 (+https://github.com/stevx11/el-ml-forecast)"

# Which provider ingestion uses.  "euroleague" hits the live API,
# "fixture" reads committed JSON from backend/tests/fixtures (offline, deterministic).
DATA_PROVIDER=euroleague

# Prediction policy.  Training rows and served predictions both use this offset
# from tip-off, so the model sees structurally identical information in both cases.
PREDICTION_LEAD_MINUTES=60

# News collection.  Comma-separated list of RSS/Atom URLs you are permitted to poll.
# Eurohoops (EuroLeague's official media partner) carries full article text,
# including each round's injury report. Read by `news collect` and the scheduler.
NEWS_FEED_URLS=https://www.eurohoops.net/en/euroleague/feed/
NEWS_FETCH_TIMEOUT_SECONDS=20
# Daily injury table, one row per player (robots.txt allows it). Read by
# `injuries report` and by the scheduler before predictions. Empty disables it.
INJURY_REPORT_URL=https://basketnews.com/news-212393-euroleague-injury-report-updated.html

# -- Scheduled pipeline ---------------------------------------------------
# UTC times of day for the unattended ingest -> score -> predict run.
# UTC on purpose: no daylight-saving discontinuity in the scheduler.
PIPELINE_RUN_AT=06:00,16:00
# How many days ahead each scheduled run projects.
PIPELINE_WITHIN_DAYS=7
